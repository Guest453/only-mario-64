{
  "_comment": [
    "Game registry. Adding a game is a file plus an entry here — never code.",
    "ROMs live on a mounted volume and are NOT part of any image.",
    "'core' names a libretro core in /usr/lib/libretro; 'exec' runs a binary",
    "directly (used later for Steam)."
  ],
  "games": [
    {
      "id": "sm64",
      "name": "Super Mario 64",
      "system": "N64 (wasm)",
      "exec": "chromium",
      "execArgs": [
        "--kiosk",
        "--app=http://127.0.0.1:8094/sm64.html",
        "--user-data-dir=/data/chromium",
        "--no-first-run",
        "--no-default-browser-check",
        "--no-sandbox",
        "--disable-dev-shm-usage",
        "--use-gl=angle",
        "--use-angle=swiftshader",
        "--enable-unsafe-swiftshader",
        "--autoplay-policy=no-user-gesture-required",
        "--disable-background-timer-throttling",
        "--disable-backgrounding-occluded-windows",
        "--disable-renderer-backgrounding",
        "--overscroll-history-navigation=0",
        "--window-size=854,480",
        "--window-position=0,0"
      ],
      "layout": "sm64"
    },
    {
      "id": "smb",
      "name": "Super Mario Bros.",
      "system": "NES",
      "core": "fceumm",
      "rom": "Super Mario Bros. (World).nes",
      "layout": "nes"
    },
    {
      "id": "sonic3k",
      "name": "Sonic 3 & Knuckles",
      "system": "Genesis",
      "core": "genesis_plus_gx",
      "rom": "Sonic & Knuckles + Sonic The Hedgehog 3 (World).md",
      "layout": "genesis"
    },
    {
      "id": "earthbound",
      "name": "EarthBound",
      "system": "SNES",
      "core": "snes9x",
      "rom": "EarthBound (USA).sfc",
      "layout": "snes"
    },
    {
      "id": "emerald",
      "name": "Pokémon Emerald",
      "system": "GBA",
      "core": "mgba",
      "rom": "Pokemon - Emerald Version (USA, Europe).gba",
      "layout": "gba"
    },
    {
      "id": "firered",
      "name": "Pokémon FireRed",
      "system": "GBA",
      "core": "mgba",
      "rom": "FireRed-v1.0-FRLG.gba",
      "layout": "gba"
    },
    {
      "id": "fnf",
      "name": "Friday Night Funkin'",
      "system": "Psych Engine (native)",
      "exec": "/data/games/fnf.sh",
      "execArgs": [],
      "layout": "rhythm"
    },
    {
      "id": "c4128b1",
      "name": "c4128b-1 (Celeron)",
      "system": "Self-hosted · light games",
      "desc": "Celeron N4020 box — RetroArch, native VNC (no browser relay).",
      "kind": "container",
      "hidden": true,
      "exec": "/app/arena/desktop/open-vnc-container.sh",
      "execArgs": [
        "localhost:5901"
      ],
      "layout": "desktop"
    },
    {
      "id": "desktop",
      "name": "XFCE Desktop (with Steam)",
      "system": "Desktop — PUBLIC SCREEN",
      "exec": "/app/arena/desktop/start-desktop.sh",
      "execArgs": [],
      "layout": "desktop",
      "warn": "Everything on this screen is broadcast to everyone in the activity. Anyone typing a real password here is typing it in public. Make a throwaway account.",
      "user": "guest"
    }
  ],
  "_layouts_comment": [
    "On-screen button layouts for touch/mobile viewers. Keyboard users get the",
    "whole keyboard regardless; these are just the buttons worth drawing.",
    "Codes are browser KeyboardEvent.code values, validated against arena/keys.js.",
    "RetroArch's own defaults: arrows = d-pad, x/z = B/A, s/a = Y/X, q/w = L/R,",
    "Enter = Start, Shift = Select."
  ],
